+void ImuProcess::PropagateOnlyBefore(const deque<sensor_msgs::ImuConstPtr>& measured,
+    double target, esekfom::esekf<state_ikfom, 12, input_ikfom>& filter)
+{
+  if (imu_need_init_ || measured.empty() || target < last_lidar_end_time_)
+    throw std::runtime_error("R6 invalid native propagation state");
+  double previous=last_imu_->header.stamp.toSec();
+  for (const auto& sample:measured) {
+    const double t=sample->header.stamp.toSec();
+    if (t<=previous || t>target) throw std::runtime_error("R6 noncausal IMU interval");
+    previous=t;
+  }
+  if (previous<=last_lidar_end_time_ || target-previous>0.020)
+    throw std::runtime_error("R6 IMU coverage/hold exceeds 20ms");
+  auto samples=measured;
+  samples.push_front(last_imu_);
+  PropagateImu(samples,last_lidar_end_time_,target,filter);
+}
