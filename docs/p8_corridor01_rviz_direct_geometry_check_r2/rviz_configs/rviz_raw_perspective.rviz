Panels:
- Class: rviz/Displays
  Help Height: 85
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Aligned Current Scan1
    Splitter Ratio: 0.5
  Tree Height: 260
- Class: rviz/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz/TF
    Enabled: false
    Filter (blacklist): ''
    Filter (whitelist): ''
    Frame Timeout: 30
    Frames:
      All Enabled: true
    Marker Alpha: 1
    Marker Scale: 1.0
    Name: TF
    Show Arrows: false
    Show Axes: false
    Show Names: false
    Tree: {}
    Update Interval: 0
    Value: true
  - Class: rviz/Axes
    Enabled: true
    Length: 0.9
    Name: 'Axes: world origin'
    Radius: 0.035
    Reference Frame: world
    Value: true
  - Class: rviz/Axes
    Enabled: true
    Length: 0.9
    Name: 'Axes: official IMU'
    Radius: 0.035
    Reference Frame: imu
    Value: true
  - Class: rviz/Axes
    Enabled: true
    Length: 0.9
    Name: 'Axes: official LiDAR'
    Radius: 0.035
    Reference Frame: lidar
    Value: true
  - Class: rviz/Axes
    Enabled: true
    Length: 0.9
    Name: 'Axes: NDT terminal'
    Radius: 0.035
    Reference Frame: tx666_ndt_lidar
    Value: true
  - Alpha: 0.68
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 175; 180; 188
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: Map (gray)
    Position Transformer: XYZ
    Queue Size: 1
    Selectable: false
    Size (Pixels): 2
    Size (m): 0.035
    Style: Points
    Topic: /corridor01/raw_map
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  - Alpha: 1.0
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 45; 230; 80
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: Official-initial scan (green)
    Position Transformer: XYZ
    Queue Size: 1
    Selectable: false
    Size (Pixels): 2
    Size (m): 0.045
    Style: Points
    Topic: /corridor01/tx666_official_raw
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  - Alpha: 1.0
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 255; 55; 55
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: NDT terminal scan (red)
    Position Transformer: XYZ
    Queue Size: 1
    Selectable: false
    Size (Pixels): 2
    Size (m): 0.045
    Style: Points
    Topic: /corridor01/tx666_ndt_raw
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 38; 44
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 1.1418028350436744
        Y: -6.224690102252498
        Z: -0.45
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.78
      Target Frame: <Fixed Frame>
      Yaw: 0.55
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 862
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1698
  X: 188
  Y: 134
