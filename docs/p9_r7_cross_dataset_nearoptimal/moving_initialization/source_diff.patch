+  uint64_t stamp_ns = 0;
+  Pose3d map_T_imu;
+  Eigen::Vector3d velocity_map = Eigen::Vector3d::Zero();
+  Eigen::Vector3d gyro_bias_imu = Eigen::Vector3d::Zero();
