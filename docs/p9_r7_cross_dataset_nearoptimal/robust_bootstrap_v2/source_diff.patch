+namespace v2 {
+namespace p = dog_prior_map_fastlio2_frontend_exp;
+using Cloud = pcl::PointCloud<pcl::PointXYZ>;
+using Matrix = Eigen::Matrix4d;
+using Clock = std::chrono::steady_clock;
+constexpr double pi = 3.14159265358979323846;
+double seconds(Clock::time_point start) {
+  return std::chrono::duration<double>(Clock::now()-start).count();
+}
+double rotationDegrees(const Eigen::Matrix3d& R) {
+  return Eigen::AngleAxisd(R).angle()*180./pi;
+}
+Eigen::Matrix3d exp(const Eigen::Vector3d& w) {
+  const double angle=w.norm();
+  return angle<1e-15 ? Eigen::Matrix3d::Identity() :
+      Eigen::AngleAxisd(angle,w/angle).toRotationMatrix();
+}
+void require(bool condition, const std::string& reason) {
+  if(!condition) throw std::runtime_error(reason);
+}
+bool rigid(const Matrix& T, double tolerance=1e-5) {
+  return T.allFinite() &&
+      (T.row(3)-Eigen::RowVector4d(0,0,0,1)).norm()<tolerance &&
+      (T.block<3,3>(0,0).transpose()*T.block<3,3>(0,0)-Eigen::Matrix3d::Identity()).norm()<tolerance &&
+      std::abs(T.block<3,3>(0,0).determinant()-1)<tolerance;
+}
+Matrix inverse(const Matrix& T) {
+  require(rigid(T),"nonrigid_transform");
+  Matrix out=Matrix::Identity();
+  out.block<3,3>(0,0)=T.block<3,3>(0,0).transpose();
+  out.block<3,1>(0,3)=-out.block<3,3>(0,0)*T.block<3,1>(0,3);
+  return out;
+}
+
+// Interval midpoint SO3 integration. Future samples are excluded before any
+// interpolation. Beginning coverage is never fabricated; endpoint-only hold
+// is bounded, and the real pair bracketing begin is included in gap validation.
+struct RotationTimeline {
+  std::vector<uint64_t> knots;
+  std::vector<Eigen::Matrix3d> rotations;
+  uint64_t maximum_gap_ns=0, endpoint_hold_ns=0, max_consumed_stamp_ns=0;
+  RotationTimeline(const p::P7ImuVector& imu, uint64_t begin, uint64_t end,
+                   double max_gap_s=.02, double endpoint_hold_s=.01) {
+    require(end>begin,"invalid_rotation_interval");
+    auto upper=std::upper_bound(imu.begin(),imu.end(),end,
+        [](uint64_t t,const p::ImuSample& s){return t<s.stamp_ns;});
+    require(upper!=imu.begin(),"no_causal_IMU");
+    auto first=std::upper_bound(imu.begin(),upper,begin,
+        [](uint64_t t,const p::ImuSample& s){return t<s.stamp_ns;});
+    require(first!=imu.begin(),"missing_leading_IMU");
+    --first;
+    max_consumed_stamp_ns=(upper-1)->stamp_ns;
+    endpoint_hold_ns=end-max_consumed_stamp_ns;
+    require(endpoint_hold_ns<=uint64_t(std::llround(endpoint_hold_s*1e9)),"IMU_endpoint_hold_exceeds_gate");
+    for(auto it=first+1;it!=upper;++it)
+      maximum_gap_ns=std::max(maximum_gap_ns,it->stamp_ns-(it-1)->stamp_ns);
+    require(maximum_gap_ns<=uint64_t(std::llround(max_gap_s*1e9)),"real_IMU_gap_exceeds_gate");
+    auto gyro=[&](uint64_t t) -> Eigen::Vector3d {
+      auto hi=std::upper_bound(first,upper,t,
+          [](uint64_t time,const p::ImuSample& s){return time<s.stamp_ns;});
+      require(hi!=first,"rotation_interpolation_backfill");
+      if(hi==upper) return (upper-1)->angular_velocity;
+      auto lo=hi-1;
+      const double alpha=double(t-lo->stamp_ns)/double(hi->stamp_ns-lo->stamp_ns);
+      return (1-alpha)*lo->angular_velocity+alpha*hi->angular_velocity;
+    };
+    knots.push_back(begin);
+    for(auto it=first;it!=upper;++it)
+      if(it->stamp_ns>begin && it->stamp_ns<end)knots.push_back(it->stamp_ns);
+    knots.push_back(end);
+    rotations.push_back(Eigen::Matrix3d::Identity());
+    for(std::size_t i=1;i<knots.size();++i) {
+      const uint64_t dt=knots[i]-knots[i-1];
+      require(dt<=uint64_t(std::llround(max_gap_s*1e9)),"IMU_knot_gap_exceeds_gate");
+      const Eigen::Vector3d w=.5*(gyro(knots[i-1])+gyro(knots[i]));
+      rotations.push_back(rotations.back()*exp(w*(double(dt)*1e-9)));
+    }
+  }
+  Eigen::Matrix3d at(uint64_t time) const {
+    require(time>=knots.front() && time<=knots.back(),"rotation_query_outside_coverage");
+    if(time==knots.back()) return rotations.back();
+    const std::size_t i=std::upper_bound(knots.begin(),knots.end(),time)-knots.begin()-1;
+    const double alpha=double(time-knots[i])/double(knots[i+1]-knots[i]);
+    const Eigen::AngleAxisd delta(rotations[i].transpose()*rotations[i+1]);
+    return rotations[i]*exp(delta.axis()*delta.angle()*alpha);
+  }
+  Eigen::Matrix3d end_T_time(uint64_t time) const {
+    return rotations.back().transpose()*at(time);
+  }
+};
+
+Eigen::Vector3d deskewPoint(const Eigen::Vector3d& lidar_point,
+                          const Eigen::Matrix3d& R_Iend_It,
+                          const Matrix& T_imu_lidar,
+                          const Eigen::Matrix3d& R_local_Iend,
+                          const Eigen::Vector3d& previous_velocity_local_imu,
+                          double time_minus_end_s) {
+  const Eigen::Matrix3d R=T_imu_lidar.block<3,3>(0,0);
+  const Eigen::Vector3d lever=T_imu_lidar.block<3,1>(0,3);
+  // Full extrinsic conjugation accounts for lever-arm motion during rotation.
+  return R.transpose()*(R_Iend_It*(R*lidar_point+lever)-lever+
+      R_local_Iend.transpose()*previous_velocity_local_imu*time_minus_end_s);
+}
+Cloud::Ptr transformCloud(const Cloud::Ptr& in,const Matrix& T) {
+  Cloud::Ptr out(new Cloud);
+  out->reserve(in->size());
+  for(const auto& p:*in) {
+    const Eigen::Vector3d q=T.block<3,3>(0,0)*Eigen::Vector3d(p.x,p.y,p.z)+T.block<3,1>(0,3);
+    out->push_back(pcl::PointXYZ(q.x(),q.y(),q.z()));
+  }
+  return out;
+}
+Cloud::Ptr voxel(const Cloud::Ptr& in) {
+  Cloud::Ptr out(new Cloud);
+  pcl::VoxelGrid<pcl::PointXYZ> grid;
+  grid.setInputCloud(in);grid.setLeafSize(.25f,.25f,.25f);grid.filter(*out);
+  return out;
+}
+struct Overlap {
+  double fraction=std::numeric_limits<double>::quiet_NaN(), trimmed_rmse=std::numeric_limits<double>::infinity();
+  std::size_t population=0, overlapping=0, retained=0;
+};
+Overlap overlap(const Cloud::Ptr& source,const Cloud::Ptr& target,double radius=.5) {
+  Overlap out;out.population=source->size();
+  if(source->size()<20||target->size()<20)return out;
+  pcl::KdTreeFLANN<pcl::PointXYZ> tree;tree.setInputCloud(target);
+  std::vector<float> squared; std::vector<int> ids(1);std::vector<float> ds(1);
+  for(const auto& point:*source)
+    if(tree.nearestKSearch(point,1,ids,ds)>0 && ds[0]<=radius*radius)squared.push_back(ds[0]);
+  out.overlapping=squared.size();out.fraction=double(out.overlapping)/out.population;
+  if(squared.empty())return out;
+  std::sort(squared.begin(),squared.end());
+  out.retained=std::max<std::size_t>(1,std::ceil(.70*squared.size()));
+  double sum=0;for(std::size_t i=0;i<out.retained;++i)sum+=squared[i];
+  out.trimmed_rmse=std::sqrt(sum/out.retained);return out;
+}
+// Source and target are independently swapped through a second solver call.
+struct Registration {
+  Matrix T_target_source=Matrix::Identity();
+  bool converged=false, invoked=false, transform_valid=false;
+  double fitness=std::numeric_limits<double>::infinity(), wall_s=0;
+  std::string error;
+};
+void normalizeSolverResult(Registration& out,const Matrix& carrier,bool solver_converged,double fitness) {
+  out.T_target_source=carrier;out.transform_valid=rigid(carrier);
+  out.converged=solver_converged&&out.transform_valid;
+  out.fitness=out.transform_valid?fitness:std::numeric_limits<double>::infinity();
+  if(!out.transform_valid)out.error="NONFINITE_OR_NONRIGID_RESULT";
+  else if(!solver_converged)out.error="SOLVER_NOT_CONVERGED";
+}
+std::string updateOutcome(bool quality,int& failures,int& max_failures,std::size_t& observations,bool& stopped) {
+  if(quality) {failures=0;++observations;return "LIDAR_OBSERVATION";}
+  ++failures;max_failures=std::max(max_failures,failures);
+  if(failures>2) {stopped=true;return "REJECTED_STOP";}
+  return "CAUSAL_PREDICTION_ONLY";
+}
+Registration registerCloud(const Cloud::Ptr& source,const Cloud::Ptr& target,const Matrix& guess) {
+  Registration out; const auto start=Clock::now();
+  if(source->size()<20 || target->size()<20) {out.error="INSUFFICIENT_SUPPORT";return out;}
+  out.invoked=true;
+  try {
+    pcl::GeneralizedIterativeClosestPoint<pcl::PointXYZ,pcl::PointXYZ> solver;
+    solver.setInputSource(source);solver.setInputTarget(target);
+    solver.setMaxCorrespondenceDistance(2.5);solver.setMaximumIterations(40);
+    solver.setTransformationEpsilon(1e-6);
+    Cloud aligned;solver.align(aligned,guess.cast<float>());
+    const Matrix carrier=solver.getFinalTransformation().cast<double>();
+    const double fitness=rigid(carrier)?solver.getFitnessScore():std::numeric_limits<double>::infinity();
+    normalizeSolverResult(out,carrier,solver.hasConverged(),fitness);
+  }catch(const std::exception&) {
+    // A solver failure is a rejected LiDAR observation, not an input-contract
+    // failure. The caller still runs the independent reverse solver.
+    out.converged=false;out.transform_valid=false;out.error="SOLVER_EXCEPTION";
+  }
+  out.wall_s=seconds(start);return out;
+}
+
+Cloud::Ptr predictedSupport(const Cloud::Ptr& submap,const Cloud::Ptr& current,const Matrix& guess) {
+  // The population is chosen ONCE from the initial prediction, before either
+  // fit. It is never recomputed from the fitted pose, quality or failure status.
+  const auto predicted=transformCloud(current,guess);
+  Cloud::Ptr support(new Cloud);
+  if(predicted->empty())return support;
+  pcl::KdTreeFLANN<pcl::PointXYZ> tree;tree.setInputCloud(predicted);
+  std::vector<int> ids(1);std::vector<float> ds(1);
+  for(const auto& point:*submap)
+    if(tree.nearestKSearch(point,1,ids,ds)>0 && ds[0]<=2.5*2.5)support->push_back(point);
+  return support;
+}
+double allPointFitness(const Cloud::Ptr& source,const Cloud::Ptr& target) {
+  if(source->empty()||target->empty())return std::numeric_limits<double>::infinity();
+  pcl::KdTreeFLANN<pcl::PointXYZ> tree;tree.setInputCloud(target);
+  std::vector<int> ids(1);std::vector<float> ds(1);double sum=0;
+  for(const auto& point:*source) {
+    if(!tree.nearestKSearch(point,1,ids,ds))return std::numeric_limits<double>::infinity();
+    sum+=ds[0];
+  }
+  return sum/source->size();
+}
+struct Config {
+  uint64_t begin=0,end=0;std::size_t scans=0;
+  Matrix T_imu_lidar=Matrix::Identity(),map_anchor=Matrix::Identity();
+  double max_gap=.02,endpoint_hold=.01,bg_bound=.05;
+  std::string input_directory,output_directory;
+};
+Matrix readMatrix(const boost::property_tree::ptree& root,const std::string& key) {
+  Matrix T; std::size_t row=0;
+  for(const auto& r:root.get_child(key)) {
+    require(row<4,"too_many_matrix_rows:"+key);std::size_t col=0;
+    for(const auto& c:r.second) {
+      require(col<4,"too_many_matrix_columns:"+key);T(row,col++)=c.second.get_value<double>();
+    }
+    require(col==4,"incomplete_matrix_row:"+key);++row;
+  }
+  require(row==4 && rigid(T,1e-8),"invalid_matrix:"+key);return T;
+}
+Config readConfig(const std::string& path) {
+  boost::property_tree::ptree root;boost::property_tree::read_json(path,root);
+  Config out;out.begin=root.get<uint64_t>("bootstrap_start_ns");
+  out.input_directory=root.get<std::string>("input_directory");out.output_directory=root.get<std::string>("output_directory");
+  require(!out.input_directory.empty() && out.input_directory[0]=='/' && !out.output_directory.empty() && out.output_directory[0]=='/',
+          "frozen_input_output_paths_must_be_absolute");
+  out.end=root.get<uint64_t>("bootstrap_end_ns");out.scans=root.get<std::size_t>("bootstrap_scan_count");
+  require(out.scans==99 && out.end>out.begin && out.end-out.begin<=10000000000ULL,"invalid_bootstrap_window");
+  out.T_imu_lidar=readMatrix(root,"T_imu_lidar");out.map_anchor=readMatrix(root,"initial_map_T_lidar");
+  require(root.get<int>("submap_frames")==3,"unfrozen_submap_frames");
+  const std::vector<std::pair<std::string,double>> gates={
+    {"lidar.voxel_m",.25},{"lidar.min_range_m",.5},{"lidar.max_range_m",80.},
+    {"lidar.max_correspondence_m",2.5},{"lidar.max_iterations",40},
+    {"lidar.transformation_epsilon",1e-6},{"lidar.overlap_radius_m",.5},
+    {"lidar.min_overlap",.55},{"lidar.trim_fraction",.70},
+    {"lidar.max_trimmed_rmse_m",.25},{"lidar.max_inverse_translation_m",.10},
+    {"lidar.max_inverse_rotation_deg",1.},{"lidar.max_step_translation_m",3.},
+    {"lidar.max_step_rotation_deg",45.},{"lidar.max_imu_rotation_error_deg",5.}};
+  for(const auto& gate:gates)
+    require(root.get<double>(gate.first)==gate.second,"quality_config_mismatch:"+gate.first);
+  out.max_gap=root.get<double>("timing.max_gap_s");out.endpoint_hold=root.get<double>("timing.endpoint_hold_s");
+  out.bg_bound=root.get<double>("timing.provisional_bg_norm_bound_rad_s");
+  require(out.max_gap==.02 && out.endpoint_hold==.01 && out.bg_bound==.05,"timing_or_bias_bound_changed");
+  return out;
+}
+struct Accepted {
+  uint64_t stamp=0;
+  Matrix pose=Matrix::Identity();
+  Cloud::Ptr cloud;
+};
+Eigen::Vector3d pastImuVelocity(const std::deque<Accepted>& accepted,const Matrix& extrinsic) {
+  require(accepted.size()>=2,"past_velocity_needs_two_true_observations");
+  const auto& a=accepted[accepted.size()-2];const auto& b=accepted.back();
+  const Matrix A=a.pose*inverse(extrinsic),B=b.pose*inverse(extrinsic);
+  require(b.stamp>a.stamp,"nonmonotonic_accepted_history");
+  return (B.block<3,1>(0,3)-A.block<3,1>(0,3))/(double(b.stamp-a.stamp)*1e-9);
+}
+Cloud::Ptr deskewCloud(const p::P7TimedLidarVector& raw,const RotationTimeline& rotation,
+                      const Config& config,const Matrix& predicted_pose,
+                      const Eigen::Vector3d& velocity,std::size_t& omitted_prefix) {
+  Cloud::Ptr deskewed(new Cloud);omitted_prefix=0;
+  const Matrix predicted_imu=predicted_pose*inverse(config.T_imu_lidar);
+  for(const auto& point:raw) {
+    if(point.stamp_ns<rotation.knots.front()) {++omitted_prefix;continue;}
+    require(point.stamp_ns<=rotation.knots.back(),"point_after_scan_end");
+    const double range=point.position.norm();
+    if(!point.position.allFinite() || range<.5 || range>80.)continue;
+    const Eigen::Vector3d q=deskewPoint(point.position,rotation.end_T_time(point.stamp_ns),config.T_imu_lidar,
+        predicted_imu.block<3,3>(0,0),velocity,-double(rotation.knots.back()-point.stamp_ns)*1e-9);
+    require(q.allFinite(),"nonfinite_deskew_point");
+    deskewed->push_back(pcl::PointXYZ(q.x(),q.y(),q.z()));
+  }
+  return voxel(deskewed);
+}
+std::string scalar(double value) {
+  if(!std::isfinite(value))return "";
+  std::ostringstream out;out<<std::setprecision(17)<<value;return out.str();
+}
+void writeRow(std::ofstream& stream,const std::vector<std::string>& columns) {
+  for(std::size_t i=0;i<columns.size();++i)stream<<(i?",":"")<<columns[i];stream<<'\n';stream.flush();
+}
+void addMatrix(std::vector<std::string>& row,const Matrix* T) {
+  for(int i=0;i<4;++i)for(int j=0;j<4;++j)row.push_back(T?scalar((*T)(i,j)):"");
+}
+std::ofstream output(const std::string& dir,const std::string& name,const std::string& header) {
+  std::ofstream stream(dir+"/"+name);require(bool(stream),"output_open_failed:"+name);
+  stream<<header<<'\n';return stream;
+}
+std::string matrixHeader(const std::string& prefix) {
+  std::string result;for(int i=0;i<4;++i)for(int j=0;j<4;++j)result+=","+prefix+std::to_string(i)+std::to_string(j);
+  return result;
+}
