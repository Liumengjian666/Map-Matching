+int run(const std::string& input,const std::string& config_path,const std::string& outdir) {
+  const auto global_start=Clock::now();const Config cfg=readConfig(config_path);
+  require(input==cfg.input_directory,"registration_input_path_not_frozen");
+  require(outdir==cfg.output_directory+"/registration","registration_output_path_not_frozen");
+  const auto all=p::readP7TimedScans(input+"/filter_scans.csv",input+"/raw_timed_scan_index.csv");
+  const auto imu=p::readP7Imu(input+"/imu.csv");
+  require(all.front().scan_start_ns==cfg.begin,"bootstrap_epoch_mismatch");
+  std::vector<p::P7TimedScanRecord> scans;
+  for(const auto& scan:all)if(scan.scan_end_ns<=cfg.end)scans.push_back(scan);
+  require(scans.size()==cfg.scans && scans.back().scan_end_ns==cfg.end,"bootstrap_scan_window_mismatch");
+  require(::mkdir(outdir.c_str(),0700)==0,"output_exists_or_not_writable; no overwrite or selective repeat");
+  auto odometry=output(outdir,"robust_lidar_odometry.csv",
+      "transaction_id,scan_start_ns,stamp_ns,raw_points,voxel_points,quality_pass,true_observation,role,reason,solver_converged,reverse_solver_converged,fitness_m2,pair_translation_m,pair_rotation_deg,imu_rotation_error_deg,position_sigma_m,rotation_sigma_deg,consecutive_failures,omitted_prefix_points,translation_prediction_status,wall_s"+matrixHeader("T"));
+  auto rotations=output(outdir,"imu_rotation_prediction.csv",
+      "transaction_id,scan_start_ns,stamp_ns,deskew_begin_ns,scan_integration_s,pair_integration_s,max_IMU_consumed_stamp_ns,IMU_max_gap_ns,endpoint_hold_ns,assumed_bg_norm_bound_rad_s,scan_bias_sensitivity_deg,pair_bias_sensitivity_deg,provisional_bg_status,translation_prediction_status,vx_local_imu,vy_local_imu,vz_local_imu"+matrixHeader("initial_local_T_lidar")+",pair_gyro_rx_rad,pair_gyro_ry_rad,pair_gyro_rz_rad");
+  auto qualities=output(outdir,"overlap_quality.csv",
+      "transaction_id,status,current_points,full_submap_points,predicted_support_points,predicted_support_fraction,forward_overlap_count,forward_population,forward_overlap,forward_trimmed_count,forward_trimmed_rmse_m,reverse_overlap_count,reverse_population,reverse_overlap,reverse_trimmed_count,reverse_trimmed_rmse_m,forward_support_allpoint_fitness_m2,forward_fullsubmap_allpoint_fitness_m2,reverse_support_allpoint_fitness_m2,reverse_fullsubmap_allpoint_fitness_m2,overlap_pass,trimmed_pass");
+  auto consistency=output(outdir,"bidirectional_consistency.csv",
