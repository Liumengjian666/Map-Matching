+int inputSelfTest(const std::string& input,const std::string& config_path,const std::string& outfile) {
+  const Config cfg=readConfig(config_path);
+  require(input==cfg.input_directory,"preflight_input_path_not_frozen");
+  const auto scans=p::readP7TimedScans(input+"/filter_scans.csv",input+"/raw_timed_scan_index.csv");
+  const auto imu=p::readP7Imu(input+"/imu.csv");
+  require(scans.front().scan_start_ns==cfg.begin,"preflight_epoch_mismatch");
+  std::ifstream exists(outfile);require(!exists.good(),"preflight_receipt_already_exists");
+  std::ofstream out(outfile);require(bool(out),"preflight_not_writable");
+  out<<"transaction_id,scan_start_ns,scan_end_ns,raw_points,voxel_points,omitted_prefix_points,IMU_max_consumed_stamp_ns,IMU_max_gap_ns,endpoint_hold_ns,deskew_finite,NEW_GICP_CALLS\n";
+  std::size_t count=0;uint64_t last_stamp=0;
+  for(const auto& scan:scans) {
+    if(scan.scan_end_ns>cfg.end)break;
+    const auto raw=p::readP7PackedTimedCloud(input+"/raw_timed_points.bin",scan);
+    const uint64_t begin=count?scan.scan_start_ns:std::max(scan.scan_start_ns,imu.front().stamp_ns);
+    const RotationTimeline within(imu,begin,scan.scan_end_ns,cfg.max_gap,cfg.endpoint_hold);
+    if(count) {
+      const RotationTimeline pair(imu,last_stamp,scan.scan_end_ns,cfg.max_gap,cfg.endpoint_hold);
+      require(pair.max_consumed_stamp_ns<=scan.scan_end_ns,"preflight_pair_future_IMU");
+    }
+    std::size_t omitted=0;
+    const auto cloud=deskewCloud(raw,within,cfg,Matrix::Identity(),Eigen::Vector3d::Zero(),omitted);
+    require((count==0 || omitted==0) && cloud->size()>=20,"preflight_point_boundary_guard");
+    require(within.max_consumed_stamp_ns<=scan.scan_end_ns,"preflight_future_IMU");
+    for(const auto& point:*cloud)require(std::isfinite(point.x)&&std::isfinite(point.y)&&std::isfinite(point.z),"preflight_nonfinite_point");
+    writeRow(out,{std::to_string(scan.transaction_id),std::to_string(scan.scan_start_ns),std::to_string(scan.scan_end_ns),
+        std::to_string(raw.size()),std::to_string(cloud->size()),std::to_string(omitted),std::to_string(within.max_consumed_stamp_ns),
+        std::to_string(within.maximum_gap_ns),std::to_string(within.endpoint_hold_ns),"PASS","0"});
+    ++count;last_stamp=scan.scan_end_ns;
+  }
+  require(count==cfg.scans && last_stamp==cfg.end,"preflight_full99_count_guard");
+  std::cout<<"REAL_INPUT_PREFLIGHT PASS scans="<<count<<" NEW_GICP_CALLS=0 NEW_NDT_CALLS=0\n";return 0;
+}
