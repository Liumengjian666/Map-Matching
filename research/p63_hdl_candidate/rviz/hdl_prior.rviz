Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
    - Class: rviz/PointCloud2
      Name: Frozen Prior
      Enabled: true
      Topic: /globalmap
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 180; 180; 180
    - Class: rviz/PointCloud2
      Name: Current Aligned Scan
      Enabled: true
      Topic: /aligned_points
      Queue Size: 1
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 80; 60
    - Class: rviz/Path
      Name: HDL UKF Trajectory
      Enabled: true
      Topic: /p63/path
      Color: 20; 220; 80
    - Class: rviz/Odometry
      Name: HDL Pose
      Enabled: true
      Topic: /odom
      Keep: 1
    - Class: rviz/TF
      Name: TF
      Enabled: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 35
      Pitch: 0.8
      Yaw: 0.7
Window Geometry:
  Width: 1280
  Height: 800
