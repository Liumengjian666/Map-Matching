<launch>

  <arg name="nodelet_manager" default="p63_hdl_manager" />
  <arg name="points_topic" default="/p63/koide_points" />


  <arg name="odom_child_frame_id" default="depth_camera_link" />


  <arg name="use_imu" default="true" />
  <arg name="invert_imu_acc" default="false" />
  <arg name="invert_imu_gyro" default="false" />
  <arg name="use_global_localization" default="false" />
  <arg name="imu_topic" default="/p63/imu_lidar" />
  <arg name="enable_robot_odometry_prediction" value="false" />
  <arg name="robot_odom_frame_id" value="odom" />
  <arg name="plot_estimation_errors" value="false" />

  <include file="$(find hdl_global_localization)/launch/hdl_global_localization.launch" if="$(arg use_global_localization)" />


  <node pkg="nodelet" type="nodelet" name="$(arg nodelet_manager)" args="manager" output="screen"><env name="LD_PRELOAD" value="/home/jian/livox_ws/p63_r9_real_imu_prediction_data/libp63_r9_trace.so" /><env name="P63_TRACE_DIR" value="$(arg output_dir)" /></node>


    <node pkg="nodelet" type="nodelet" name="globalmap_server_nodelet" args="load hdl_localization/GlobalmapServerNodelet $(arg nodelet_manager)">
      <param name="globalmap_pcd" value="/home/jian/livox_ws/p63_r8_indoor_hard_holdout_data/r29_hard_tiles_exact_xyzi.pcd" />
      <param name="convert_utm_to_local" value="false" />
      <param name="downsample_resolution" value="0.1" />
    <remap from="/map_request/pcd" to="/p63_disabled/map_request/pcd" /></node>


    <node pkg="nodelet" type="nodelet" name="hdl_localization_nodelet" args="load hdl_localization/HdlLocalizationNodelet $(arg nodelet_manager)">
      <remap from="/velodyne_points" to="$(arg points_topic)" />
      <remap from="/gpsimu_driver/imu_data" to="$(arg imu_topic)" />

      <param name="odom_child_frame_id" value="$(arg odom_child_frame_id)" />


      <param name="use_imu" value="$(arg use_imu)" />
      <param name="invert_acc" value="$(arg invert_imu_acc)" />
      <param name="invert_gyro" value="$(arg invert_imu_gyro)" />
      <param name="cool_time_duration" value="2.0" />

      <param name="enable_robot_odometry_prediction" value="$(arg enable_robot_odometry_prediction)" />
      <param name="robot_odom_frame_id" value="$(arg robot_odom_frame_id)" />


      <param name="reg_method" value="NDT_OMP" />

      <param name="ndt_neighbor_search_method" value="DIRECT7" />
      <param name="ndt_neighbor_search_radius" value="2.0" />
      <param name="ndt_resolution" value="1.0" />
      <param name="downsample_resolution" value="0.1" />


      <param name="specify_init_pose" value="true" />
      <param name="init_pos_x" value="11.444582998915708" />
      <param name="init_pos_y" value="-6.15695200007346" />
      <param name="init_pos_z" value="-0.25219200080805415" />
      <param name="init_ori_w" value="-0.5298699841695934" />
      <param name="init_ori_x" value="0.7000149833588958" />
      <param name="init_ori_y" value="0.4137409893604594" />
      <param name="init_ori_z" value="-0.24090499511672192" />

      <param name="use_global_localization" value="$(arg use_global_localization)" />
    <remap from="/initialpose" to="/p63_disabled/initialpose" /></node>

    <node pkg="hdl_localization" type="plot_status.py" name="plot_estimation_errors" if="$(arg plot_estimation_errors)" />
<arg name="output_dir" /><arg name="rviz" default="true" /><node pkg="rviz" type="rviz" name="p63_hdl_rviz" if="$(arg rviz)" args="-d $(find p63_hdl_indoor_hard)/rviz/indoor.rviz" output="screen"><env name="DISABLE_ROS1_EOL_WARNINGS" value="1" /></node><node pkg="p63_hdl_indoor_hard" type="display_path.py" name="p63_r5_path" output="screen" /><arg name="autoplay" default="false" /><node pkg="p63_hdl_indoor_hard" type="replay_scans.py" name="p63_r5_player" if="$(arg autoplay)" output="screen"><param name="input_freeze" value="/home/jian/livox_ws/p63_r8_indoor_hard_holdout_ws/docs/p63_r8_hdl_indoor_hard_holdout/INPUT_FREEZE.json" /></node></launch>