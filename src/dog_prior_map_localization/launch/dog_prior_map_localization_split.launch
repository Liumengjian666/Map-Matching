<launch>
  <arg name="config" default="$(find dog_prior_map_localization)/config/dog_prior_map_localization_ndt.yaml" />
  <arg name="rviz" default="false" />
  <arg name="runtime_csv_path" default="" />
  <arg name="ndt_diagnostics_csv_path" default="" />
  <arg name="oosm_enable" default="false" />
  <arg name="oosm_max_alignment_sec" default="0.02" />
  <arg name="oosm_csv_path" default="" />
  <arg name="diagnostic_determinism_enable" default="false" />
  <arg name="ndt_determinism_csv_path" default="" />
  <arg name="information_diagnostic_enable" default="false" />
  <arg name="local_vio_metric_enable" default="false" />
  <arg name="directional_fusion_enable" default="false" />
  <arg name="state_machine_enable" default="false" />
  <arg name="degenerated_eigen_ratio" default="0.03" />
  <arg name="lidar_degraded_enter_frames" default="5" />
  <arg name="visual_assisted_enter_frames" default="3" />
  <arg name="both_degraded_enter_frames" default="3" />
  <arg name="recovery_exit_frames" default="5" />
  <rosparam command="load" file="$(arg config)" />

  <!--
    拆分版结构：
    1) dog_prior_map_ndt：只负责当前帧点云预处理 + NDT先验地图匹配，输出低频绝对位姿/dog_livo/ndt_odom。
    2) dog_prior_map_ekf：只负责IMU高频传播 + 接收NDT低频观测修正，输出高频位姿/dog_livo/odom_high_rate。
    原来的 dog_prior_map_localization.launch 不改，仍可运行一体化节点。
  -->

  <param name="ndt_observation/enable" value="true" />
  <param name="ndt_observation/apply_ratio" value="1.0" />
  <param name="ndt_observation/z_apply_ratio" value="1.0" />
  <param name="ndt_observation/roll_pitch_apply_ratio" value="1.0" />
  <param name="ndt_observation/max_translation_correction" value="2.0" />
  <param name="ndt_observation/max_rotation_correction_deg" value="20.0" />
  <param name="ndt_observation/oosm_enable" value="$(arg oosm_enable)" />
  <param name="ndt_observation/oosm_max_alignment_sec" value="$(arg oosm_max_alignment_sec)" />
  <param name="lidar_update/enable" value="false" />
  <param name="output/runtime_csv_path" value="$(arg runtime_csv_path)" />
  <param name="output/oosm_csv_path" value="$(arg oosm_csv_path)" />
  <param name="output/ndt_diagnostics_csv_path" value="$(arg ndt_diagnostics_csv_path)" />
  <param name="output/diagnostic_determinism_enable" value="$(arg diagnostic_determinism_enable)" />
  <param name="output/ndt_determinism_csv_path" value="$(arg ndt_determinism_csv_path)" />
  <param name="lidar_update/information_diagnostic_enable" value="$(arg information_diagnostic_enable)" />
  <param name="camera_update/local_vio_metric_enable" value="$(arg local_vio_metric_enable)" />
  <param name="fusion/directional_enable" value="$(arg directional_fusion_enable)" />
  <param name="fusion/state_machine_enable" value="$(arg state_machine_enable)" />
  <param name="fusion/degenerated_eigen_ratio" value="$(arg degenerated_eigen_ratio)" />
  <param name="fusion/lidar_degraded_enter_frames" value="$(arg lidar_degraded_enter_frames)" />
  <param name="fusion/visual_assisted_enter_frames" value="$(arg visual_assisted_enter_frames)" />
  <param name="fusion/both_degraded_enter_frames" value="$(arg both_degraded_enter_frames)" />
  <param name="fusion/recovery_exit_frames" value="$(arg recovery_exit_frames)" />

  <node pkg="dog_prior_map_localization"
        type="dog_prior_map_ndt_node_cpp"
        name="dog_prior_map_ndt"
        output="screen">
    <!-- MVS SDK会把/opt/MVS/lib/64放进LD_LIBRARY_PATH，其中旧版libusb会导致PCL/NDT启动时报
         symbol lookup error: libpcl_io.so.1.10: undefined symbol: libusb_set_option。
         这里只让定位节点优先使用系统libusb，不修改全局环境，也不影响相机驱动。 -->
    <env name="LD_PRELOAD" value="/lib/x86_64-linux-gnu/libusb-1.0.so.0" />
  </node>

  <node pkg="dog_prior_map_localization"
        type="dog_prior_map_ekf_node_cpp"
        name="dog_prior_map_ekf"
        output="screen">
    <env name="LD_PRELOAD" value="/lib/x86_64-linux-gnu/libusb-1.0.so.0" />
  </node>

  <group if="$(arg rviz)">
    <node pkg="rviz"
          type="rviz"
          name="dog_prior_map_rviz"
          args="-d $(find dog_prior_map_localization)/rviz/dog_prior_map_localization.rviz" />
  </group>
</launch>
