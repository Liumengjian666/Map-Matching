<launch>
  <arg name="config" default="$(find dog_prior_map_localization)/config/dog_prior_map_localization_ndt.yaml" />
  <arg name="rviz" default="false" />
  <arg name="runtime_csv_path" default="" />
  <arg name="ndt_diagnostics_csv_path" default="" />
  <arg name="ndt_fusion_mode" default="reliability_eskf" />
  <arg name="lidar_msg_type" default="livox" />
  <arg name="map_path" default="/home/jian/rosbag/loop2/loop2mapping/pcd/loop2_simtime_rebuild_2026_08_12_001_all_downsampled_points.pcd" />
  <arg name="max_covariance_inflation" default="100.0" />
  <arg name="camera_enable" default="true" />
  <arg name="hard_reject_nis_threshold" default="0.0" />
  <arg name="max_frame_translation" default="0.5" />
  <rosparam command="load" file="$(arg config)" />

  <!--
    拆分版结构：
    1) dog_prior_map_ndt：只负责当前帧点云预处理 + NDT先验地图匹配，输出低频绝对位姿/dog_livo/ndt_odom。
    2) dog_prior_map_ekf：只负责IMU高频传播 + 接收NDT低频观测修正，输出高频位姿/dog_livo/odom_high_rate。
    原来的 dog_prior_map_localization.launch 不改，仍可运行一体化节点。
  -->

  <param name="ndt_observation/enable" value="true" />
  <param name="ndt_observation/fusion_mode" value="$(arg ndt_fusion_mode)" />
  <param name="ndt_observation/nis_threshold" value="22.458" />
  <param name="ndt_observation/max_covariance_inflation" value="$(arg max_covariance_inflation)" />
  <param name="camera_update/enable" value="$(arg camera_enable)" />
  <param name="ndt_observation/hard_reject_nis_threshold" value="$(arg hard_reject_nis_threshold)" />
  <param name="ndt_observation/max_frame_translation" value="$(arg max_frame_translation)" />
  <param name="lidar_update/ndt_hard_reject_max_translation" value="$(arg max_frame_translation)" />
  <param name="ndt_observation/fixed_position_std_m" value="0.08" />
  <param name="ndt_observation/fixed_rotation_std_deg" value="1.0" />
  <param name="topics/lidar_msg_type" value="$(arg lidar_msg_type)" />
  <param name="map/pcd_fallback_path" value="$(arg map_path)" />
  <param name="ndt_observation/apply_ratio" value="1.0" />
  <param name="ndt_observation/z_apply_ratio" value="1.0" />
  <param name="ndt_observation/roll_pitch_apply_ratio" value="1.0" />
  <param name="ndt_observation/max_translation_correction" value="2.0" />
  <param name="ndt_observation/max_rotation_correction_deg" value="20.0" />
  <param name="lidar_update/enable" value="false" />
  <param name="output/runtime_csv_path" value="$(arg runtime_csv_path)" />
  <param name="output/ndt_diagnostics_csv_path" value="$(arg ndt_diagnostics_csv_path)" />

  <node pkg="dog_prior_map_localization"
        type="dog_prior_map_ndt_node_cpp"
        name="dog_prior_map_ndt"
        output="screen">
    <!-- MVS SDK会把/opt/MVS/lib/64放进LD_LIBRARY_PATH，其中旧版libusb会导致PCL/NDT启动时报
         symbol lookup error: libpcl_io.so.1.10: undefined symbol: libusb_set_option。
         这里只让定位节点优先使用系统libusb，不修改全局环境，也不影响相机驱动。 -->
    <env name="LD_PRELOAD" value="/lib/x86_64-linux-gnu/libusb-1.0.so.0" />
  </node>

  <node pkg="dog_prior_map_localization"
        type="dog_prior_map_ekf_node_cpp"
        name="dog_prior_map_ekf"
        output="screen">
    <env name="LD_PRELOAD" value="/lib/x86_64-linux-gnu/libusb-1.0.so.0" />
  </node>

  <group if="$(arg rviz)">
    <node pkg="rviz"
          type="rviz"
          name="dog_prior_map_rviz"
          args="-d $(find dog_prior_map_localization)/rviz/dog_prior_map_localization.rviz" />
  </group>
</launch>
