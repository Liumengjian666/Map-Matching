<launch>
  <arg name="scan_count" default="20" />
  <arg name="start_stamp_ns" default="1583836591182590976" />
  <arg name="output_dir" default="/media/jian/HIKVISION/paper rosbag/NewerCollege/.p49_causal_record/smoke20" />
  <arg name="scan_ack_timeout_sec" default="120.0" />

  <include file="$(find dog_prior_map_localization)/launch/newer_college_local_map.launch">
    <arg name="scan_count" value="$(arg scan_count)" />
    <arg name="start_stamp_ns" value="$(arg start_stamp_ns)" />
    <arg name="output_dir" value="$(arg output_dir)" />
    <arg name="scan_ack_timeout_sec" value="$(arg scan_ack_timeout_sec)" />
    <arg name="rviz" value="false" />
    <arg name="causal_record_only_enable" value="true" />
    <arg name="causal_record_directory" value="$(arg output_dir)" />
  </include>
</launch>
