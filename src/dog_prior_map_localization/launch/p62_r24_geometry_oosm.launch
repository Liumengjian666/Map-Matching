<launch>
  <arg name="geometry_diagnostic_only" default="false" />
  <arg name="revision_sync" default="false" />
  <arg name="initialization_config" default="$(find dog_prior_map_localization)/../../docs/p62_r23_real_imu_closure/config/w1_c0_initialization.yaml" />
  <arg name="start_stamp_ns" default="1583836851179232512" />
  <arg name="imu_replay_start_stamp_ns" default="1583836851078989056" />
  <arg name="expected_boundary_imu_stamp_ns" default="1583836851078961159" />
  <arg name="scan_count" default="60" />
  <arg name="output_dir" />
  <include file="$(find dog_prior_map_localization)/launch/p62_r23_integrated_localization.launch">
    <arg name="strategy" value="MULTISTART_C" />
    <arg name="initialization_config" value="$(arg initialization_config)" />
    <arg name="start_stamp_ns" value="$(arg start_stamp_ns)" />
    <arg name="imu_replay_start_stamp_ns" value="$(arg imu_replay_start_stamp_ns)" />
    <arg name="expected_boundary_imu_stamp_ns" value="$(arg expected_boundary_imu_stamp_ns)" />
    <arg name="scan_count" value="$(arg scan_count)" />
    <arg name="output_dir" value="$(arg output_dir)" />
    <arg name="rviz" value="false" />
  </include>
  <param name="research/r24_enable" value="true" />
  <param name="research/r24_geometry_diagnostic_only" value="$(arg geometry_diagnostic_only)" />
  <param name="research/r24_revision_sync" value="$(arg revision_sync)" />
</launch>
