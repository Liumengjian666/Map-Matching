Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Display Grid (not the prior map)
      Enabled: true
      Value: true
      Reference Frame: <Fixed Frame>
      Plane: XY
      Plane Cell Count: 100
      Cell Size: 10
      Color: 100; 100; 100
      Alpha: 0.5
      Line Style:
        Value: Lines
        Line Width: 0.03
    - Class: rviz/Path
      Name: Complete GT (inverse YAML hypothesis)
      Enabled: true
      Value: true
      Topic: /dog_livo/gt_path_full
      Color: 0; 255; 255
      Alpha: 1
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 1.0
      Pose Style: None
      Queue Size: 1
    - Class: rviz/PointCloud2
      Name: Corridor02 Prior Map
      Enabled: true
      Value: true
      Topic: /dog_livo/prior_map
      Queue Size: 1
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 210; 210; 210
      Alpha: 0.5
      Style: Points
      Size (Pixels): 1
      Decay Time: 0
    - Class: rviz/Path
      Name: Algorithm Corrected Path (when running)
      Enabled: true
      Value: true
      Topic: /dog_livo/path_corrected
      Color: 0; 255; 0
      Alpha: 1
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 1.0
      Pose Style: None
      Queue Size: 1
    - Class: rviz/Path
      Name: Algorithm High Rate Path (when running)
      Enabled: false
      Value: false
      Topic: /dog_livo/path_high_rate
      Color: 255; 170; 0
      Alpha: 1
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 1.0
      Pose Style: None
      Queue Size: 1
    - Class: rviz/Marker
      Name: GT Moving Pose (published reference)
      Enabled: true
      Value: true
      Marker Topic: /dog_livo/gt_current_pose
      Queue Size: 1
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 850
      Focal Point: {X: 225, Y: 178, Z: 12}
      Pitch: 1.3
      Yaw: 0.7853981634
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1100
  Height: 800
  X: 100
  Y: 100
