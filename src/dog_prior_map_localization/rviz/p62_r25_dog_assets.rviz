Panels:
- Class: rviz/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Prior Map1
    - /Local NDT Target1
    - /Deskewed Current Scan1
    - /NDT Aligned Scan1
    - /NDT Path1
    - /EKF High-Rate Path1
    Splitter Ratio: 0.5
  Tree Height: 500
- Class: rviz/Views
  Name: Views
  Expanded:
  - /Current View1
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz/TF
    Enabled: true
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Value: true
  - Class: rviz/PointCloud2
    Name: Prior Map
    Enabled: true
    Topic: /dog_livo/prior_map
    Queue Size: 1
    Style: Flat Squares
    Size (Pixels): 1
    Size (m): 0.05
    Color Transformer: FlatColor
    Color: 155; 155; 155
    Alpha: 0.35
    Value: true
  - Class: rviz/PointCloud2
    Name: Local NDT Target
    Enabled: false
    Topic: /dog_livo/prior_map
    Queue Size: 1
    Style: Flat Squares
    Size (Pixels): 2
    Size (m): 0.08
    Color Transformer: FlatColor
    Color: 0; 190; 255
    Alpha: 0.55
    Value: false
  - Class: rviz/PointCloud2
    Name: Current Filtered Scan (dog Deskew OFF)
    Enabled: true
    Topic: /dog_livo/filtered_points
    Queue Size: 1
    Style: Points
    Size (Pixels): 3
    Size (m): 0.04
    Color Transformer: FlatColor
    Color: 255; 210; 0
    Value: true
  - Class: rviz/PointCloud2
    Name: NDT Aligned Scan
    Enabled: true
    Topic: /dog_livo/points_aligned
    Queue Size: 2
    Style: Points
    Size (Pixels): 3
    Size (m): 0.04
    Color Transformer: FlatColor
    Color: 255; 45; 45
    Value: true
  - Class: rviz/Pose
    Name: NDT Pose
    Enabled: true
    Topic: /dog_livo/ndt_pose
    Shape: Axes
    Axes Length: 1
    Axes Radius: 0.1
    Value: true
  - Class: rviz/Path
    Name: NDT Path
    Enabled: true
    Topic: /dog_livo/ndt_path
    Color: 0; 255; 0
    Line Style: Lines
    Line Width: 0.08
    Value: true
  - Class: rviz/Path
    Name: EKF High-Rate Path
    Enabled: true
    Topic: /dog_livo/path_high_rate
    Color: 0; 160; 255
    Line Style: Lines
    Line Width: 0.04
    Value: true
  - Class: rviz/Path
    Name: EKF Corrected Path
    Enabled: true
    Topic: /dog_livo/path_corrected
    Color: 255; 180; 0
    Line Style: Lines
    Line Width: 0.05
    Value: true
  - Class: rviz/Path
    Name: Same-system Reference (unqualified, optional)
    Enabled: false
    Value: false
    Topic: /dog_livo/reference_path
    Color: 200; 100; 200
    Line Style: Lines
    Line Width: 0.03
    Buffer Length: 1
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: camera_init
    Frame Rate: 20
  Name: R23 Real IMU / NDT / EKF / Conditional Base
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 35
      Target Frame: camera_init
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.9
      Yaw: 0.8
      Value: true
Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 50
