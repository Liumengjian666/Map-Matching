-anchor_relocalization:
-  enable: false                # 小范围锚点重定位在loop3重复结构中会误吸附，默认关闭
-  period_sec: 5.0              # 最快每隔几秒触发一次，避免低算力端每帧全局搜索
-  trigger_residual: 0.20       # 当前地图匹配残差偏高时，认为可能累积漂移
-  trigger_degeneracy_score: 0.55 # 雷达明显退化时才触发，避免普通区域浪费算力
-  search_radius: 1.5           # XY只做局部搜索；不做全局硬匹配，降低重复走廊误吸附风险
-  search_step: 0.3             # 30cm网格先粗找局部低残差候选
-  yaw_search_deg: 3.0          # 额外搜索yaw扰动范围
-  yaw_step_deg: 1.5
-  min_effective_points: 120    # 候选位置至少要有足够地图近邻点
-  accept_residual: 0.14        # 候选平均残差足够低，才允许作为锚点
-  improve_ratio: 0.85          # 候选残差需要优于当前残差，避免重复长廊误匹配
-  max_correction: 0.6          # 单次最多拉回60cm，分多次修正累计误差
-  apply_ratio: 0.5             # 对通过验证的锚点不硬跳，只应用一半修正
