-vertical_relocalization:
-  enable: false                # 单独Z搜索在重复楼层/长廊中残差歧义明显，默认关闭，避免误吸附
-  period_sec: 1.0              # 每秒最多一次，控制低算力平台开销
-  search_radius: 8.0           # loop3末尾约6m高度漂移，搜索范围需覆盖该量级
-  search_step: 0.5
-  max_points: 350              # 当前帧用于Z评分的最大点数，避免全点云暴力最近邻
-  min_effective_points: 70
-  accept_residual: 0.18
-  improve_ratio: 0.80          # 候选高度必须明显优于当前高度，避免楼层/天花板误吸附
-  max_correction: 0.8          # 单次最大Z修正，防错误候选一把拉飞
-  apply_ratio: 0.6
