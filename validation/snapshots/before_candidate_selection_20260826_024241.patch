-lidar_update:
-  enable: true
-  prior_map_update_enable: true # 必须显式打开先验地图匹配；避免ROS参数服务器残留false导致只跑局部里程计
-  deskew_enable: true           # 使用Livox点级offset_time和IMU做帧内去畸变
-  deskew_translation_enable: true # 对帧内平移也做补偿；雷达点是主约束，默认打开
-  offset_time_scale: 0.000000001 # livox_ros_driver2里offset_time单位为ns；老驱动若为us才改成0.000001
-  registration_method: "fastlio_hybrid" # 点到面主约束 + 弱点到点约束，抑制长走廊沿平面滑移
-  update_every_n_scans: 1       # 每帧雷达都做低频地图更新，避免轨迹被速度阻尼压缩
-  scan_voxel_size: 0.30         # 当前帧点云降采样，轻量部署先用0.30降低CPU
-  max_scan_points: 650          # 当前帧最多参与匹配点数；控制算力，后续完整验证再调
-  scan_min_range: 0.6           # 去除车体/机器狗附近自遮挡和近距离毛刺点
-  scan_max_range: 45.0          # 室内先不用超远稀疏点，减少错误最近邻和动态远点
-  scan_min_z: -2.5              # 去除明显低于机器人附近楼层的离群点
-  scan_max_z: 3.5               # 去除天花板以上/反射造成的异常高点；楼梯场景可适当放宽
-  scan_radius_outlier_enable: true
-  scan_radius_outlier_radius: 0.80
-  scan_radius_outlier_min_neighbors: 2
-  max_match_distance: 0.35      # 最近邻超过此距离拒绝；收紧可减少重复走廊中的远距离误吸附
-  min_effective_points: 50
-  point_to_point_noise: 0.20    # 匹配残差噪声，越大越保守
-  hybrid_point_noise: 0.60      # hybrid里点到点弱约束噪声，防止沿平面滑移但不强拉
-  point_to_plane_noise: 0.12    # 点到面残差噪声，通常比点到点更小
-  plane_neighbor_k: 5           # FAST-LIO式5近邻平面拟合
-  plane_min_eigen_ratio: 0.08   # PCA平面质量阈值，越小越严格
-  fastlio_plane_threshold: 0.10 # FAST-LIO式平面拟合内点阈值
-  fastlio_residual_gate: 0.90   # FAST-LIO式 s=1-0.9*|pd|/sqrt(range)，大于该值才保留
-  fastlivo_outlier_reject_enable: true # 借鉴FAST-LIVO2：平面半径门控+sigma门控+概率权重，剔除错误局部平面
-  plane_radius_gate_scale: 5.0  # 点在平面切向上不能离平面中心太远；MID360点少，门控要比FAST-LIVO2原始体素平面更宽
-  plane_sigma_gate: 5.0         # 点到面残差小于sigma_gate*sqrt(局部平面不确定度)才作为内点
-  plane_min_radius: 0.10        # 防止近邻点过密时平面半径过小导致误删
-  plane_min_sigma: 0.08         # 最小点到面sigma，避免不确定度估计过小
-  range_noise_per_meter: 0.006  # 简化雷达测距噪声模型，随距离增加而增大
-  fastlivo_body_cov_enable: true # 学FAST-LIVO2，把雷达测距/角度噪声投影到平面法向参与sigma门控
-  lidar_depth_noise: 0.05        # FAST-LIVO2 lio/dept_err默认量级，单位m
-  lidar_beam_noise_deg: 0.02     # FAST-LIVO2 lio/beam_err默认量级，单位deg
-  horizontal_plane_z_observation_enable: false # 关闭单独Z方向增权，避免人为把轨迹压到某个高度层；保留普通点到面三维匹配
-  horizontal_plane_normal_z_min: 0.85         # 局部平面法向|nz|超过该值，才认为它主要约束高度
-  horizontal_plane_weight_scale: 1.5          # 水平面点到面残差增权倍率；过大可能被错误楼层吸附
-  horizontal_plane_residual_gate: 0.30        # 只有残差足够小的水平面内点才增权，避免错误最近邻拉Z
-  huber_threshold: 0.30
-  max_iterations: 2             # 地图匹配EKF迭代，部署版先用2次控制耗时
-  max_translation_update: 0.20  # 单次更新最大平移修正，防错误匹配拉飞
-  max_rotation_update_deg: 1.5
-  max_update_time_ms: 60.0      # 单帧地图匹配软预算；机器狗端优先保证实时性
-  match_accept_gate_enable: true
-  match_accept_max_mean_residual: 0.22        # 候选位姿最近邻平均误差太大就拒绝
-  match_accept_max_residual_increase_ratio: 1.02 # 地图匹配不能比预测残差明显更差
-  match_accept_min_improvement_ratio: 0.00    # 当前先保守：不要求明显变好，但不允许变差
-  match_accept_min_effective_ratio: 0.08      # 有效匹配点比例过低时拒绝，防走廊局部误吸附
-  match_accept_max_translation: 0.20          # 单帧地图匹配最多修正20cm，避免形状对但整体被拉到旁边走廊
-  match_accept_max_rotation_deg: 1.5
-  match_accept_degenerate_max_translation: 0.08 # 雷达退化时只允许小步修正，避免重复走廊误吸附
-  match_accept_degenerate_max_rotation_deg: 0.6
-  ndt_enable: false             # NDT在loop3实测约200ms/帧且失败率高，默认关闭，仅作离线对比
-  ndt_source_voxel_size: 0.35
-  ndt_target_voxel_size: 0.30
-  ndt_max_source_points: 900
-  ndt_max_target_points: 25000
-  ndt_max_iterations: 12
-  ndt_resolution: 1.0
-  ndt_step_size: 0.1
-  ndt_transformation_epsilon: 0.01
-  ndt_max_fitness_score: 0.60
-  gicp_enable: false            # GICP在loop3实测约200ms/帧且更易被重复走廊误吸附，默认关闭
-  gicp_source_voxel_size: 0.35  # 当前帧GICP体素；越小越精但越耗CPU
-  gicp_target_voxel_size: 0.25  # 局部地图GICP体素；室内稀疏MID360不宜过大
-  gicp_max_source_points: 900   # 限制当前帧点数，面向机器狗低算力部署
-  gicp_max_target_points: 25000 # 限制局部地图点数，防止长廊局部地图过大
-  gicp_max_iterations: 6
-  gicp_max_correspondence_distance: 0.7
-  gicp_max_fitness_score: 0.30
-  gicp_transformation_epsilon: 0.0001
-  multires_icp_enable: false    # 实测当前ICP易被室内重复结构拉偏；代码保留，默认关闭
-  icp_coarse_voxel_size: 0.80   # 粗层体素，负责快速拉近
-  icp_fine_voxel_size: 0.35     # 细层体素，负责精调
-  icp_coarse_iterations: 8
-  icp_fine_iterations: 5
-  icp_max_correspondence_distance: 1.5
-  icp_max_fitness_score: 0.8
-  degeneracy_check_enable: true       # 检测长廊/平面等LiDAR退化，不削弱雷达主约束
-  degeneracy_min_eigenvalue: 0.001    # 信息矩阵最小特征值过小，说明存在弱约束方向
-  degeneracy_max_condition_number: 100000.0 # 条件数过大，说明不同方向约束强弱悬殊
-  degeneracy_geometry_ratio: 0.08     # 匹配点PCA最小/最大特征值过小，认为几何分布退化
-  degeneracy_project_update_enable: true  # 长廊退化时把LiDAR弱约束方向投影降权，避免错误最近邻强行修正
-  degeneracy_project_eigen_ratio: 0.05   # 特征值小于max_eigen的该比例，认为该组合方向LiDAR约束弱
-  degeneracy_project_min_scale: 0.08      # 最弱方向仍保留少量地图修正，避免完全锁死真实运动
