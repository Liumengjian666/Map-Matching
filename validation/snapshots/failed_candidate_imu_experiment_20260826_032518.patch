+  double candidatePriorDistance(const Eigen::Matrix4d &prediction,
+                                const Eigen::Matrix4d &pose) const
+  {
+    const Eigen::Matrix4d delta = prediction.inverse() * pose;
+    const double translation = delta.block<3, 1>(0, 3).norm();
+    const double yaw_deg = std::abs(wrapPi(yawFromRot(delta.block<3, 3>(0, 0)))) * 180.0 / M_PI;
+    return translation + std::max(0.0, ndt_candidate_yaw_distance_weight_) * yaw_deg;
+  }
