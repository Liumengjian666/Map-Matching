+      offsets.push_back({ ndt_candidate_xy_radius_, 0.0, 0.0, 0.0});
+      offsets.push_back({-ndt_candidate_xy_radius_, 0.0, 0.0, 0.0});
+      offsets.push_back({0.0,  ndt_candidate_xy_radius_, 0.0, 0.0});
